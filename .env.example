# Postgres do Neon. Use a connection string com pooler para o app.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Conexão direta do Neon, sem pooler. Só é usada por `prisma migrate`.
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Senha única compartilhada pela equipe do escritório.
APP_PASSWORD="troque-esta-senha"

# Token que você inventa e repete no painel da Meta ao configurar o webhook.
WHATSAPP_VERIFY_TOKEN="troque-este-token"

# Opcional: App Secret do app da Meta. Se preenchido, o webhook confere a
# assinatura X-Hub-Signature-256 de cada POST.
WHATSAPP_APP_SECRET=""
